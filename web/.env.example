# Snowflake connection name from ~/.snowflake/config.toml
# Set this to match your named connection
SNOWFLAKE_CONNECTION_NAME=default

# Database and schema the demo objects were created in (defaults shown)
SNOWFLAKE_DATABASE=BUSINESS_ONTOLOGY
SNOWFLAKE_SCHEMA=SAP

# Warehouse created by sql/01_setup.sql
SNOWFLAKE_WAREHOUSE=BUSINESS_ONTOLOGY_WH
