# Local runs only. Copy to .streamlit/secrets.toml (git-ignored) and fill in your own details.
# Inside Snowflake (Streamlit in Snowflake) no secrets are needed.
[connections.snowflake]
account = "<account_identifier>"
user = "<user>"
authenticator = "externalbrowser"
role = "<role>"
warehouse = "BUSINESS_ONTOLOGY_WH"
database = "BUSINESS_ONTOLOGY"
schema = "SAP"
